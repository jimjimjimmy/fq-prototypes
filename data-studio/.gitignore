# Dependencies
node_modules/

# Build artifacts
dist/
.vite/

# Environment & secrets
.env
.env.local
.env.*.local

# Obsidian vault (personal note-taking)
.obsidian/

# Audit screenshots (large binaries, excluded for now)
audit/*.png

# Claude Code per-project config (launch.json, settings.local.json) — personal
# IDE/preview config that shouldn't be committed. The root .gitignore covers
# the repo-root .claude/settings.local.json but doesn't reach nested ones, so
# we ignore the whole folder here.
.claude/

# OS files
.DS_Store

# Logs
*.log
